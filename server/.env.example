# Server
PORT=3003
NODE_ENV=production

# MySQL (usa tus credenciales)
DATABASE_URL=mysql://root:TU_PASSWORD@localhost:3306/tiusdei

# JWT (for auth tokens)
JWT_SECRET=your_jwt_secret_change_in_production

# SMTP Email Configuration (qbitdashboard@gmail.com para enviar notificaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=qbitdashboard@gmail.com
SMTP_PASS=tu_app_password_de_gmail
SMTP_FROM="TIUSDEI <qbitdashboard@gmail.com>"

# Opcional: para cron de avisos de deadline (ej: cron ejecuta POST /api/email/deadline-warning con este token)
# CRON_SECRET=tu_secreto_aleatorio

# Webhook Secret (for validating incoming webhooks)
WEBHOOK_SECRET=your_webhook_secret_here

# Frontend URL (for CORS and email links)
FRONTEND_URL=https://tiusdei.qbit.ec
