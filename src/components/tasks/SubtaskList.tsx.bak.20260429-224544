import { useEffect, useState, KeyboardEvent } from 'react';
import * as api from '@/lib/apiClient';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Checkbox } from '@/components/ui/checkbox';
import { Badge } from '@/components/ui/badge';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { Plus, Loader2, GripVertical, Trash2, Pencil, Check, X } from 'lucide-react';
import { toast } from 'sonner';
import {
  DndContext,
  closestCenter,
  KeyboardSensor,
  PointerSensor,
  useSensor,
  useSensors,
  DragEndEvent,
} from '@dnd-kit/core';
import {
  SortableContext,
  sortableKeyboardCoordinates,
  useSortable,
  verticalListSortingStrategy,
  arrayMove,
} from '@dnd-kit/sortable';
import { CSS } from '@dnd-kit/utilities';

interface Subtask {
  id: string;
  titulo_tarea: string;
  estado: string;
  check_done: number | boolean;
  prioridad: string;
}

const ESTADOS = ['backlog', 'en_proceso', 'en_revision', 'aprobado', 'entregado', 'bloqueado'] as const;
const PRIORIDADES = ['alta', 'media', 'baja'] as const;

const estadoColors: Record<string, string> = {
  backlog: 'bg-gray-100 text-gray-700',
  en_proceso: 'bg-blue-100 text-blue-700',
  en_revision: 'bg-yellow-100 text-yellow-700',
  aprobado: 'bg-green-100 text-green-700',
  entregado: 'bg-emerald-100 text-emerald-700',
  bloqueado: 'bg-red-100 text-red-700',
};

const estadoLabels: Record<string, string> = {
  backlog: 'Backlog',
  en_proceso: 'En proceso',
  en_revision: 'En revisión',
  aprobado: 'Aprobado',
  entregado: 'Entregado',
  bloqueado: 'Bloqueado',
};

const prioridadColors: Record<string, string> = {
  alta: 'bg-red-100 text-red-700 border-red-200',
  media: 'bg-yellow-100 text-yellow-700 border-yellow-200',
  baja: 'bg-gray-100 text-gray-600 border-gray-200',
};

// ---------- Sortable item (una subtarea) ----------
function SortableRow({
  st,
  onToggle,
  onSave,
  onDelete,
  onChangeEstado,
  onChangePrioridad,
}: {
  st: Subtask;
  onToggle: () => void;
  onSave: (newTitle: string) => Promise<void>;
  onDelete: () => void;
  onChangeEstado: (estado: string) => void;
  onChangePrioridad: (prioridad: string) => void;
}) {
  const { attributes, listeners, setNodeRef, transform, transition, isDragging } = useSortable({ id: st.id });
  const [editing, setEditing] = useState(false);
  const [draftTitle, setDraftTitle] = useState(st.titulo_tarea);
  const [saving, setSaving] = useState(false);

  const style = {
    transform: CSS.Transform.toString(transform),
    transition,
    opacity: isDragging ? 0.5 : 1,
  };

  const commitEdit = async () => {
    const trimmed = draftTitle.trim();
    if (!trimmed || trimmed === st.titulo_tarea) {
      setEditing(false);
      setDraftTitle(st.titulo_tarea);
      return;
    }
    setSaving(true);
    try {
      await onSave(trimmed);
      setEditing(false);
    } catch {
      toast.error('Error al guardar');
    }
    setSaving(false);
  };

  const handleKey = (e: KeyboardEvent<HTMLInputElement>) => {
    if (e.key === 'Enter') commitEdit();
    if (e.key === 'Escape') {
      setEditing(false);
      setDraftTitle(st.titulo_tarea);
    }
  };

  return (
    <div
      ref={setNodeRef}
      style={style}
      className="flex items-center gap-2 py-1.5 px-1 rounded hover:bg-muted/40 group"
    >
      <button
        type="button"
        {...attributes}
        {...listeners}
        className="cursor-grab active:cursor-grabbing opacity-40 group-hover:opacity-100 touch-none"
        aria-label="Reordenar"
        title="Arrastrar para reordenar"
      >
        <GripVertical className="w-4 h-4" />
      </button>

      <Checkbox checked={!!st.check_done} onCheckedChange={onToggle} />

      {editing ? (
        <div className="flex-1 flex items-center gap-1">
          <Input
            value={draftTitle}
            onChange={(e) => setDraftTitle(e.target.value)}
            onKeyDown={handleKey}
            onBlur={commitEdit}
            autoFocus
            className="h-7 text-sm"
            disabled={saving}
          />
          <Button size="sm" variant="ghost" className="h-7 w-7 p-0" onClick={commitEdit} disabled={saving}>
            {saving ? <Loader2 className="w-3 h-3 animate-spin" /> : <Check className="w-3 h-3" />}
          </Button>
          <Button
            size="sm"
            variant="ghost"
            className="h-7 w-7 p-0"
            onClick={() => {
              setEditing(false);
              setDraftTitle(st.titulo_tarea);
            }}
          >
            <X className="w-3 h-3" />
          </Button>
        </div>
      ) : (
        <span
          className={`text-sm flex-1 cursor-text ${st.check_done ? 'line-through text-muted-foreground' : ''}`}
          onDoubleClick={() => setEditing(true)}
          title="Doble click para editar"
        >
          {st.titulo_tarea}
        </span>
      )}

      <Select value={st.prioridad} onValueChange={onChangePrioridad}>
        <SelectTrigger className={`h-6 w-[70px] text-xs border ${prioridadColors[st.prioridad] || ''}`}>
          <SelectValue />
        </SelectTrigger>
        <SelectContent>
          {PRIORIDADES.map((p) => (
            <SelectItem key={p} value={p} className="text-xs capitalize">
              {p}
            </SelectItem>
          ))}
        </SelectContent>
      </Select>

      <Select value={st.estado} onValueChange={onChangeEstado}>
        <SelectTrigger className={`h-6 w-[110px] text-xs ${estadoColors[st.estado] || ''}`}>
          <SelectValue />
        </SelectTrigger>
        <SelectContent>
          {ESTADOS.map((e) => (
            <SelectItem key={e} value={e} className="text-xs">
              {estadoLabels[e]}
            </SelectItem>
          ))}
        </SelectContent>
      </Select>

      <Button
        size="sm"
        variant="ghost"
        className="h-7 w-7 p-0 opacity-50 group-hover:opacity-100"
        onClick={() => setEditing(true)}
        title="Editar título"
      >
        <Pencil className="w-3.5 h-3.5" />
      </Button>

      <Button
        size="sm"
        variant="ghost"
        className="h-7 w-7 p-0 text-red-600 opacity-50 group-hover:opacity-100 hover:bg-red-50"
        onClick={onDelete}
        title="Eliminar subtarea"
      >
        <Trash2 className="w-3.5 h-3.5" />
      </Button>
    </div>
  );
}

// ---------- Lista principal ----------
export function SubtaskList({ taskId, onUpdate }: { taskId: string; onUpdate?: () => void }) {
  const [subtasks, setSubtasks] = useState<Subtask[]>([]);
  const [loading, setLoading] = useState(true);
  const [newTitle, setNewTitle] = useState('');
  const [adding, setAdding] = useState(false);

  const sensors = useSensors(
    useSensor(PointerSensor, { activationConstraint: { distance: 5 } }),
    useSensor(KeyboardSensor, { coordinateGetter: sortableKeyboardCoordinates })
  );

  const fetchSubtasks = async () => {
    try {
      const data = await api.getSubtasks(taskId);
      setSubtasks(data || []);
    } catch {
      /* ignore */
    }
    setLoading(false);
  };

  useEffect(() => {
    fetchSubtasks();
  }, [taskId]);

  const handleAdd = async () => {
    if (!newTitle.trim()) return;
    setAdding(true);
    try {
      await api.createSubtask(taskId, { titulo_tarea: newTitle.trim() });
      setNewTitle('');
      await fetchSubtasks();
      onUpdate?.();
      toast.success('Subtarea creada');
    } catch {
      toast.error('Error al crear subtarea');
    }
    setAdding(false);
  };

  const toggleDone = async (st: Subtask) => {
    const newDone = !st.check_done;
    // optimistic
    setSubtasks((prev) =>
      prev.map((s) => (s.id === st.id ? { ...s, check_done: newDone, estado: newDone ? 'entregado' : 'en_proceso' } : s))
    );
    try {
      await api.patchTask(st.id, {
        check_done: newDone,
        estado: newDone ? 'entregado' : 'en_proceso',
      });
      onUpdate?.();
    } catch {
      toast.error('Error al actualizar');
      fetchSubtasks();
    }
  };

  const saveTitle = async (st: Subtask, newTitleVal: string) => {
    setSubtasks((prev) => prev.map((s) => (s.id === st.id ? { ...s, titulo_tarea: newTitleVal } : s)));
    await api.patchTask(st.id, { titulo_tarea: newTitleVal });
    onUpdate?.();
    toast.success('Título actualizado');
  };

  const changeEstado = async (st: Subtask, estado: string) => {
    setSubtasks((prev) =>
      prev.map((s) =>
        s.id === st.id
          ? { ...s, estado, check_done: estado === 'entregado' || estado === 'aprobado' ? 1 : 0 }
          : s
      )
    );
    try {
      await api.patchTask(st.id, {
        estado,
        check_done: estado === 'entregado' || estado === 'aprobado',
      });
      onUpdate?.();
    } catch {
      toast.error('Error al cambiar estado');
      fetchSubtasks();
    }
  };

  const changePrioridad = async (st: Subtask, prioridad: string) => {
    setSubtasks((prev) => prev.map((s) => (s.id === st.id ? { ...s, prioridad } : s)));
    try {
      await api.patchTask(st.id, { prioridad });
      onUpdate?.();
    } catch {
      toast.error('Error al cambiar prioridad');
      fetchSubtasks();
    }
  };

  const handleDelete = async (st: Subtask) => {
    if (!confirm(`¿Eliminar la subtarea "${st.titulo_tarea}"?`)) return;
    const prev = subtasks;
    setSubtasks((cur) => cur.filter((s) => s.id !== st.id));
    try {
      await api.deleteSubtask(taskId, st.id);
      onUpdate?.();
      toast.success('Subtarea eliminada');
    } catch {
      toast.error('Error al eliminar');
      setSubtasks(prev);
    }
  };

  const handleDragEnd = async (event: DragEndEvent) => {
    const { active, over } = event;
    if (!over || active.id === over.id) return;
    const oldIndex = subtasks.findIndex((s) => s.id === active.id);
    const newIndex = subtasks.findIndex((s) => s.id === over.id);
    if (oldIndex === -1 || newIndex === -1) return;
    const reordered = arrayMove(subtasks, oldIndex, newIndex);
    setSubtasks(reordered);
    try {
      await api.reorderSubtasks(
        taskId,
        reordered.map((s) => s.id)
      );
    } catch {
      toast.error('Error al reordenar');
      fetchSubtasks();
    }
  };

  if (loading) return <div className="text-sm text-muted-foreground py-2">Cargando subtareas...</div>;

  const completed = subtasks.filter((s) => !!s.check_done).length;

  return (
    <div className="space-y-2">
      <div className="flex items-center justify-between">
        <span className="text-sm font-medium">
          Subtareas ({completed}/{subtasks.length})
        </span>
        {subtasks.length > 0 && (
          <div className="w-24 h-1.5 bg-muted rounded-full overflow-hidden">
            <div
              className="h-full bg-green-500 transition-all"
              style={{
                width: `${subtasks.length > 0 ? (completed / subtasks.length) * 100 : 0}%`,
              }}
            />
          </div>
        )}
      </div>

      <DndContext sensors={sensors} collisionDetection={closestCenter} onDragEnd={handleDragEnd}>
        <SortableContext items={subtasks.map((s) => s.id)} strategy={verticalListSortingStrategy}>
          <div className="space-y-0.5">
            {subtasks.map((st) => (
              <SortableRow
                key={st.id}
                st={st}
                onToggle={() => toggleDone(st)}
                onSave={(t) => saveTitle(st, t)}
                onDelete={() => handleDelete(st)}
                onChangeEstado={(e) => changeEstado(st, e)}
                onChangePrioridad={(p) => changePrioridad(st, p)}
              />
            ))}
          </div>
        </SortableContext>
      </DndContext>

      {subtasks.length > 0 && (
        <Badge variant="outline" className="text-[10px] text-muted-foreground">
          Tip: doble-click en el título para editar, arrastrar con ⋮⋮ para reordenar
        </Badge>
      )}

      <div className="flex gap-2">
        <Input
          placeholder="Nueva subtarea..."
          value={newTitle}
          onChange={(e) => setNewTitle(e.target.value)}
          onKeyDown={(e) => e.key === 'Enter' && handleAdd()}
          className="h-8 text-sm"
        />
        <Button size="sm" variant="outline" onClick={handleAdd} disabled={adding || !newTitle.trim()}>
          {adding ? <Loader2 className="w-3 h-3 animate-spin" /> : <Plus className="w-3 h-3" />}
        </Button>
      </div>
    </div>
  );
}
