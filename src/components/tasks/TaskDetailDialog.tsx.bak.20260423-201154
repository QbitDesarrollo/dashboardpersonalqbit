import { useEffect, useState } from 'react';
import * as api from '@/lib/apiClient';
import { useAuth } from '@/contexts/AuthContext';
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription } from '@/components/ui/dialog';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar';
import { Eye, Calendar, Loader2, Clock, Repeat } from 'lucide-react';
import { toast } from 'sonner';
import { cn, getInitials } from '@/lib/utils';
import { TaskTimer } from '@/components/tasks/TaskTimer';
import { TaskFiles } from '@/components/tasks/TaskFiles';
import { DeliverableProgress } from '@/components/tasks/DeliverableProgress';
import { CommentsPanel } from '@/components/tasks/CommentsPanel';
import { RichTextViewer } from '@/components/RichTextEditor';

interface TaskDetailDialogProps {
  taskId: string | null;
  open: boolean;
  onOpenChange: (open: boolean) => void;
}

interface TaskData {
  id: string;
  titulo_tarea: string;
  detalle?: string;
  estado: string;
  prioridad: string;
  fecha_inicio?: string;
  fecha_entrega: string;
  cantidad_entregables: number;
  story_points?: number;
  tiempo_trabajado?: number;
  timer_activo?: boolean;
  timer_inicio?: string;
  enlaces?: string[];
  responsable_user_id?: string | null;
  desk_id?: string | null;
  google_event_id?: string | null;
  brands?: { nombre: string } | null;
  desks?: { nombre: string } | null;
  profiles?: { nombre: string; avatar_url: string | null } | null;
  responsables?: { user_id: string; nombre: string; avatar_url: string | null }[];
  feature?: { name: string } | null;
  sprint?: { name: string } | null;
  task_type?: { nombre: string } | null;
  deliverable_type?: { nombre: string } | null;
  created_by_profile?: { nombre: string; avatar_url: string | null } | null;
  created_by?: string | null;
  created_by_rol?: string | null;
  estimated_hours?: number | null;
  recurrence_type?: string;
  recurrence_interval?: number | null;
  recurrence_end_date?: string | null;
}

const getPriorityColor = (prioridad: string) => {
  switch (prioridad) {
    case 'alta': return 'bg-priority-high text-white';
    case 'media': return 'bg-priority-medium text-black';
    case 'baja': return 'bg-priority-low text-white';
    default: return 'bg-muted text-muted-foreground';
  }
};

const getStatusColor = (estado: string) => {
  const colors: Record<string, string> = {
    backlog: 'bg-status-backlog text-white',
    en_proceso: 'bg-status-in-progress text-white',
    en_revision: 'bg-status-in-review text-black',
    aprobado: 'bg-status-approved text-white',
    entregado: 'bg-status-delivered text-white',
    bloqueado: 'bg-status-blocked text-white',
  };
  return colors[estado] || 'bg-muted text-muted-foreground';
};

const getStatusLabel = (estado: string) => {
  const labels: Record<string, string> = {
    backlog: 'Backlog',
    en_proceso: 'En Proceso',
    en_revision: 'En Revisión',
    aprobado: 'Aprobado',
    entregado: 'Entregado',
    bloqueado: 'Bloqueado',
  };
  return labels[estado] || estado;
};

const parseLocalDate = (dateStr: string) => {
  const clean = dateStr.substring(0, 10);
  const [y, m, d] = clean.split('-').map(Number);
  return new Date(y, m - 1, d);
};

export function TaskDetailDialog({ taskId, open, onOpenChange }: TaskDetailDialogProps) {
  const { profile, isAdmin, isEjecutivo, isEquipo } = useAuth();
  const [task, setTask] = useState<TaskData | null>(null);
  const [loading, setLoading] = useState(false);
  const [taskReads, setTaskReads] = useState<{ user_id: string; read_at: string; nombre: string; avatar_url: string | null }[]>([]);

  useEffect(() => {
    if (!open || !taskId) {
      setTask(null);
      setTaskReads([]);
      return;
    }
    setLoading(true);
    api.getTask(taskId)
      .then((data: any) => {
        setTask(data);
        // Mark as read
        api.markTaskRead(taskId).catch(() => {});
        api.getTaskReads(taskId)
          .then((reads) => setTaskReads(Array.isArray(reads) ? reads : []))
          .catch(() => setTaskReads([]));
      })
      .catch(() => {
        toast.error('No se pudo cargar la tarea');
        onOpenChange(false);
      })
      .finally(() => setLoading(false));
  }, [open, taskId]);

  const isAssigned = () =>
    task?.responsable_user_id === profile?.id || task?.responsables?.some(r => r.user_id === profile?.id);

  const canEdit = () => {
    if (!task) return false;
    if (isAdmin) return true;
    const isProtected = task.created_by_rol === 'admin' || task.created_by_rol === 'ejecutivo';
    if (isEjecutivo) return !isProtected || task.created_by === profile?.id;
    if (isEquipo) return !isProtected && isAssigned();
    return false;
  };

  // Equipo can change status/timer on protected tasks if assigned
  const canOperate = () => canEdit() || (isEquipo && isAssigned());

  const updateStatus = async (status: string) => {
    if (!task) return;
    try {
      const result: any = await api.patchTask(task.id, { estado: status });
      if (result?.error) throw new Error(result.error);
      setTask({ ...task, estado: status });
      toast.success('Estado actualizado');
    } catch (error: any) {
      toast.error('Error', { description: error.message });
    }
  };

  const refreshTask = () => {
    if (!taskId) return;
    api.getTask(taskId).then((data: any) => setTask(data)).catch(() => {});
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="max-w-5xl w-[95vw] max-h-[92vh] overflow-y-auto p-4 sm:p-6" aria-describedby="task-detail-standalone-desc">
        <DialogHeader>
          <DialogTitle className="text-xl">{task?.titulo_tarea || 'Detalle de Tarea'}</DialogTitle>
          <DialogDescription id="task-detail-standalone-desc">Información completa, timer, comentarios y entregables.</DialogDescription>
        </DialogHeader>

        {loading && (
          <div className="flex items-center justify-center py-12">
            <Loader2 className="h-8 w-8 animate-spin text-primary" />
          </div>
        )}

        {task && !loading && (
          <div className="space-y-5">
            {/* Header badges */}
            <div className="flex items-center gap-2 flex-wrap">
              <Badge className={getPriorityColor(task.prioridad)}>
                {task.prioridad.toUpperCase()}
              </Badge>
              <Badge className={getStatusColor(task.estado)}>
                {getStatusLabel(task.estado)}
              </Badge>
              {task.task_type && <Badge variant="outline">{task.task_type.nombre}</Badge>}
              {task.deliverable_type && <Badge variant="outline" className="text-xs">{task.deliverable_type.nombre}</Badge>}
              {task.sprint && <Badge variant="outline" className="text-xs">{task.sprint.name}</Badge>}
              {task.recurrence_type && task.recurrence_type !== 'none' && (
                <Badge variant="outline" className="text-xs text-blue-600 border-blue-300 gap-1">
                  <Repeat className="h-3 w-3" />
                  Recurrente
                </Badge>
              )}
            </div>

            {/* Two-column layout */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              {/* Left column — info */}
              <div className="space-y-5">
                {/* Metadata grid */}
                <div className="grid grid-cols-2 gap-3 text-sm p-4 rounded-lg border border-border bg-muted/20">
                  <div>
                    <span className="text-muted-foreground text-xs block">Marca</span>
                    <span className="font-medium">{task.brands?.nombre || '-'}</span>
                  </div>
                  <div>
                    <span className="text-muted-foreground text-xs block">Mesa</span>
                    <span className="font-medium">{task.desks?.nombre || '-'}</span>
                  </div>
                  <div>
                    <span className="text-muted-foreground text-xs block">Fecha Inicio</span>
                    <span className="font-medium">
                      {task.fecha_inicio ? parseLocalDate(task.fecha_inicio).toLocaleDateString('es-ES') : '-'}
                    </span>
                  </div>
                  <div>
                    <span className="text-muted-foreground text-xs block">Fecha Entrega</span>
                    <span className="font-medium">
                      {parseLocalDate(task.fecha_entrega).toLocaleDateString('es-ES')}
                    </span>
                  </div>
                  <div>
                    <span className="text-muted-foreground text-xs block">Entregables</span>
                    <span className="font-medium">{task.cantidad_entregables}</span>
                  </div>
                  {task.story_points != null && (
                    <div>
                      <span className="text-muted-foreground text-xs block">Story Points</span>
                      <span className="font-medium">{task.story_points}</span>
                    </div>
                  )}
                  {task.estimated_hours != null && task.estimated_hours > 0 && (
                    <div>
                      <span className="text-muted-foreground text-xs block">Estimado vs Real</span>
                      <div className="flex items-center gap-1.5">
                        <Clock className="h-3.5 w-3.5 text-muted-foreground" />
                        <span className="font-medium">{task.estimated_hours}h est.</span>
                        <span className="text-muted-foreground">/</span>
                        <span className={cn("font-medium", (task.tiempo_trabajado || 0) > task.estimated_hours * 3600 ? "text-destructive" : "text-green-600")}>
                          {((task.tiempo_trabajado || 0) / 3600).toFixed(1)}h real
                        </span>
                      </div>
                    </div>
                  )}
                  {task.recurrence_type && task.recurrence_type !== 'none' && (
                    <div>
                      <span className="text-muted-foreground text-xs block">Recurrencia</span>
                      <div className="flex items-center gap-1.5">
                        <Repeat className="h-3.5 w-3.5 text-blue-500" />
                        <span className="font-medium capitalize">
                          {task.recurrence_type === 'daily' ? 'Diaria' :
                           task.recurrence_type === 'weekly' ? 'Semanal' :
                           task.recurrence_type === 'biweekly' ? 'Quincenal' :
                           task.recurrence_type === 'monthly' ? 'Mensual' :
                           `Cada ${task.recurrence_interval || '?'} días`}
                        </span>
                        {task.recurrence_end_date && (
                          <span className="text-xs text-muted-foreground">
                            hasta {parseLocalDate(task.recurrence_end_date).toLocaleDateString('es-ES')}
                          </span>
                        )}
                      </div>
                    </div>
                  )}
                  {task.feature && (
                    <div>
                      <span className="text-muted-foreground text-xs block">Feature</span>
                      <span className="font-medium">{task.feature.name}</span>
                    </div>
                  )}
                  {task.deliverable_type && (
                    <div>
                      <span className="text-muted-foreground text-xs block">Tipo Entregable</span>
                      <span className="font-medium">{task.deliverable_type.nombre}</span>
                    </div>
                  )}
                  <div>
                    <span className="text-muted-foreground text-xs block">Autor</span>
                    <div className="flex items-center gap-1.5 mt-0.5">
                      <Avatar className="h-5 w-5">
                        {task.created_by_profile?.avatar_url ? (
                          <AvatarImage src={task.created_by_profile.avatar_url} alt={task.created_by_profile.nombre} className="object-cover" />
                        ) : null}
                        <AvatarFallback className="bg-primary/20 text-primary text-[8px] font-semibold">
                          {getInitials(task.created_by_profile?.nombre || '?')}
                        </AvatarFallback>
                      </Avatar>
                      <span className="font-medium">{task.created_by_profile?.nombre || '—'}</span>
                    </div>
                  </div>
                </div>

                {/* Timer Section */}
                <div>
                  <h4 className="text-sm font-medium text-muted-foreground mb-2">Tiempo Trabajado</h4>
                  <TaskTimer
                    taskId={task.id}
                    initialTime={task.tiempo_trabajado}
                    isActive={task.timer_activo}
                    startTime={task.timer_inicio}
                    canEdit={canOperate()}
                    onUpdate={refreshTask}
                  />
                </div>

                {/* Responsable Section */}
                {((task.responsables && task.responsables.length > 0) || task.responsable_user_id) && (
                  <div className="p-4 rounded-lg border border-border bg-muted/30">
                    <h4 className="text-sm font-medium text-muted-foreground mb-3">Responsable{(task.responsables?.length || 0) > 1 ? 's' : ''}</h4>
                    <div className="space-y-2">
                      {(task.responsables && task.responsables.length > 0) ? (
                        task.responsables.map((r) => (
                          <div key={r.user_id} className="flex items-center gap-2">
                            <Avatar className="h-7 w-7">
                              {r.avatar_url ? <AvatarImage src={r.avatar_url} alt={r.nombre} className="object-cover" /> : null}
                              <AvatarFallback className="bg-primary/20 text-primary text-xs font-semibold">
                                {getInitials(r.nombre || '?')}
                              </AvatarFallback>
                            </Avatar>
                            <span className="font-medium">{r.nombre}</span>
                          </div>
                        ))
                      ) : (
                        <div className="flex items-center gap-2">
                          <Avatar className="h-7 w-7">
                            {task.profiles?.avatar_url ? <AvatarImage src={task.profiles.avatar_url} alt={task.profiles.nombre} className="object-cover" /> : null}
                            <AvatarFallback className="bg-primary/20 text-primary text-xs font-semibold">
                              {getInitials(task.profiles?.nombre || '?')}
                            </AvatarFallback>
                          </Avatar>
                          <span className="font-medium">{task.profiles?.nombre || 'Sin asignar'}</span>
                        </div>
                      )}
                    </div>
                  </div>
                )}

                {/* Deliverable Progress */}
                <DeliverableProgress
                  taskId={task.id}
                  expectedCount={task.cantidad_entregables}
                />

                {/* Visto por */}
                {taskReads.length > 0 && (
                  <div className="p-4 rounded-lg border border-border bg-muted/20">
                    <h4 className="text-sm font-medium text-muted-foreground mb-3 flex items-center gap-1.5">
                      <Eye className="h-4 w-4" />
                      Visto por ({taskReads.length})
                    </h4>
                    <div className="flex flex-wrap gap-2">
                      {taskReads.map((reader) => (
                        <div key={reader.user_id} className="flex items-center gap-1.5 bg-muted/40 rounded-md px-2 py-1">
                          <Avatar className="h-6 w-6">
                            {reader.avatar_url ? (
                              <AvatarImage src={reader.avatar_url} alt={reader.nombre} className="object-cover" />
                            ) : null}
                            <AvatarFallback className="bg-primary/20 text-primary text-[8px] font-semibold">
                              {getInitials(reader.nombre || '?')}
                            </AvatarFallback>
                          </Avatar>
                          <div className="flex flex-col">
                            <span className="text-xs font-medium">{reader.nombre}</span>
                            <span className="text-[10px] text-muted-foreground">
                              {new Date(reader.read_at).toLocaleString('es-ES', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })}
                            </span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {task.detalle && (
                  <div>
                    <h4 className="text-sm font-medium text-muted-foreground mb-1">Detalle</h4>
                    <div className="bg-muted/30 p-3 rounded-lg border border-border/50">
                      <RichTextViewer content={task.detalle} />
                    </div>
                  </div>
                )}

                {task.enlaces && task.enlaces.length > 0 && (
                  <div>
                    <h4 className="text-sm font-medium text-muted-foreground mb-1">Enlaces</h4>
                    <div className="space-y-1">
                      {task.enlaces.map((link, i) => (
                        <a
                          key={i}
                          href={link}
                          target="_blank"
                          rel="noopener noreferrer"
                          className="block text-sm text-primary hover:underline truncate"
                        >
                          {link}
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              {/* Right column — status, files, comments, calendar */}
              <div className="space-y-5">
                {canOperate() && (
                  <div className="pb-4 border-b border-border">
                    <h4 className="text-sm font-medium text-muted-foreground mb-2">Cambiar Estado</h4>
                    <div className="flex flex-wrap gap-2">
                      {['backlog', 'en_proceso', 'en_revision', 'aprobado', 'entregado', 'bloqueado'].map((status) => (
                        <Button
                          key={status}
                          variant={task.estado === status ? "default" : "outline"}
                          size="sm"
                          onClick={() => updateStatus(status)}
                        >
                          {getStatusLabel(status)}
                        </Button>
                      ))}
                    </div>
                  </div>
                )}

                {/* Files Section */}
                <TaskFiles
                  taskId={task.id}
                  canEdit={canEdit()}
                />

                {/* Comentarios (realtime) */}
                <CommentsPanel taskId={task.id} deskId={task.desk_id || undefined} />

                {/* Google Calendar Sync */}
                <div className="pt-4 border-t border-border">
                  <div className="flex items-center justify-between">
                    <h4 className="text-sm font-medium text-muted-foreground flex items-center gap-1.5">
                      <Calendar className="h-4 w-4" />
                      Google Calendar
                    </h4>
                    {task.google_event_id ? (
                      <div className="flex items-center gap-2">
                        <Badge variant="outline" className="text-xs text-green-600 border-green-300">Sincronizado</Badge>
                        <Button
                          variant="outline"
                          size="sm"
                          className="h-7 text-xs"
                          onClick={async () => {
                            try {
                              await api.syncTaskToGoogleCalendar(task.id);
                              toast.success('Evento actualizado en Google Calendar');
                            } catch { toast.error('Error al actualizar evento'); }
                          }}
                        >
                          Actualizar
                        </Button>
                        <Button
                          variant="ghost"
                          size="sm"
                          className="h-7 text-xs text-destructive"
                          onClick={async () => {
                            try {
                              await api.unsyncTaskFromGoogleCalendar(task.id);
                              setTask({ ...task, google_event_id: null });
                              toast.success('Evento eliminado de Google Calendar');
                            } catch { toast.error('Error al eliminar evento'); }
                          }}
                        >
                          Desvincular
                        </Button>
                      </div>
                    ) : (
                      <Button
                        variant="outline"
                        size="sm"
                        className="h-7 text-xs gap-1"
                        onClick={async () => {
                          try {
                            const result = await api.syncTaskToGoogleCalendar(task.id);
                            setTask({ ...task, google_event_id: result.google_event_id });
                            toast.success('Tarea sincronizada con Google Calendar');
                          } catch (e) {
                            toast.error(e instanceof Error ? e.message : 'Error al sincronizar');
                          }
                        }}
                      >
                        <Calendar className="h-3 w-3" />
                        Sincronizar
                      </Button>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}
      </DialogContent>
    </Dialog>
  );
}
