  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuTrigger,
} from '@/components/ui/dropdown-menu';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table';
import { Checkbox } from '@/components/ui/checkbox';
import { toast } from 'sonner';
import { cn, getInitials } from '@/lib/utils';
import {
  Plus,
  Search,
  Eye,
  Edit,
  Trash2,
  Bookmark,
  BookmarkPlus,
  MessageSquare,
  Paperclip,
  Calendar,
  Loader2,
  X,
  Check,
  Timer,
  Package,
  LayoutGrid,
  Columns3,
  GanttChart,
  ChevronDown,
  ChevronRight,
  Link2,
  Star,
  SlidersHorizontal,
  FolderOpen,
  Repeat,
  Clock,
} from 'lucide-react';
